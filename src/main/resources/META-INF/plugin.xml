<idea-plugin>
    <id>pl.mdreview.markdown-review</id>
    <name>Markdown Review</name>
    <vendor url="https://github.com/agadek">agadek</vendor>
    <description><![CDATA[
        Review changes in Markdown files in <b>rendered</b> form, inside IntelliJ's own diff window:
        <ul>
          <li>side-by-side rendered diff: removed blocks on red, added on green, changed words highlighted;</li>
          <li>merged view: one column, removals struck through, additions in green;</li>
          <li>the built-in text diff one click away;</li>
          <li>works for local changes, history, branch comparison and pull requests,
              plus <i>Compare Markdown Files...</i> for any two files.</li>
        </ul>
        Free for noncommercial use under the
        <a href="https://polyformproject.org/licenses/noncommercial/1.0.0">PolyForm Noncommercial License 1.0.0</a>.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Only to recognize the Markdown file type for files without a .md-like extension; rendering uses commonmark. -->
    <depends optional="true" config-file="markdown-review-withMarkdown.xml">org.intellij.plugins.markdown</depends>

    <resource-bundle>messages.MarkdownReviewBundle</resource-bundle>

    <extensionPoints>
        <extensionPoint qualifiedName="pl.mdreview.markdownFileTypeRecognizer"
                        interface="pl.mdreview.ide.MarkdownFileTypeRecognizer" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <diff.DiffTool implementation="pl.mdreview.ide.RenderedSideBySideTool"/>
        <diff.DiffTool implementation="pl.mdreview.ide.RenderedMergedTool"/>
        <applicationConfigurable parentId="tools" id="pl.mdreview.settings"
                                 instance="pl.mdreview.ide.MarkdownReviewConfigurable"
                                 key="settings.display.name"/>
        <postStartupActivity implementation="pl.mdreview.ide.DefaultViewerStartupActivity"/>
    </extensions>

    <actions>
        <action id="MarkdownReview.CompareFiles" class="pl.mdreview.ide.CompareMarkdownFilesAction">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
